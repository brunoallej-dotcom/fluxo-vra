{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(node --check:*)",
      "Bash(npm run check)",
      "Bash(npm run test:rules)",
      "Bash(npm run test:e2e)",
      "Bash(python3 -m http.server 5500 --bind 127.0.0.1)"
    ],
    "ask": [
      "Bash(npx firebase deploy:*)",
      "Bash(firebase deploy:*)",
      "Bash(npx firebase-tools@15.36.0 deploy:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Read(./.env)",
      "Read(./.env.local*)",
      "Edit(./.env)",
      "Edit(./.env.local*)",
      "Read(**/*adminsdk*.json)",
      "Edit(**/*adminsdk*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-secrets.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__firebase__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/firebase-mcp-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-edit.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
