rules_version = '2';

// REGRAS DE CONTENÇÃO (provisórias) — docs/specs/autenticacao-multiusuario.md §5.3
//
// O app atual (sem login) continua funcionando com estas regras; a leitura
// segue pública. Elas só reduzem o estrago possível até o cutover, quando são
// substituídas pelas regras completas da spec §5.2 (Onda 2 / Onda 4b).
// Também aceitam o formato da Fase 1 (updatedBy/updatedAt) e a leitura de
// fluxo_users por quem está logado, para o passo 5 do cutover funcionar.
service cloud.firestore {
  match /databases/{database}/documents {

    // updatedBy/updatedAt só têm o tipo conferido aqui; a autoria (updatedBy ==
    // request.auth.uid) só passa a ser garantida pelas regras completas (§5.2).
    function validPayload() {
      let d = request.resource.data;
      return d.keys().hasOnly(['data', 'updatedBy', 'updatedAt'])
        && d.data is string
        && d.data.size() <= 900000
        && (!('updatedBy' in d) || d.updatedBy is string)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    match /fluxo/{docId} {
      function knownDoc() {
        return docId in ['tasks', 'meetings'] || docId.matches('routine(_[A-Za-z0-9_]+)?');
      }
      allow read: if knownDoc();
      allow create, update: if knownDoc() && validPayload();
      allow delete: if false;
    }

    match /fluxo_clients/{clientId} {
      allow read, delete: if true;
      allow create, update: if validPayload();
    }

    match /fluxo_users/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
